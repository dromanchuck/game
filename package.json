{
  "name": "grid-bomb-dodge",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @grid-bomb-dodge/web",
    "build": "npm run build -w @grid-bomb-dodge/web",
    "preview": "npm run preview -w @grid-bomb-dodge/web",
    "mobile": "npm run start -w @grid-bomb-dodge/mobile",
    "lint": "oxlint",
    "test": "npm test -w @grid-bomb-dodge/game-core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
